# Cloud Whisper provider (pick one)
# Groq is fast and has a free tier: https://console.groq.com
GROQ_API_KEY=

# Or OpenAI Whisper
OPENAI_API_KEY=

# Optional override. Defaults:
# - groq when GROQ_API_KEY is set: whisper-large-v3
# - openai when OPENAI_API_KEY is set: whisper-1
# WHISPER_MODEL=whisper-large-v3
